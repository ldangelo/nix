#!/bin/bash
# tmux plugin bootstrap. Re-runs when the plugin list in tmux.conf changes.
# tmux.conf hash: {{ include "dot_config/tmux/tmux.conf" | sha256sum }}
set -euo pipefail
mkdir -p "$HOME/.local/share/tmux/resurrect" "$HOME/.local/share/tmux/continuum"
TPM="$HOME/.config/tmux/plugins/tpm"
if [ -x "$TPM/bin/install_plugins" ]; then
  # TPM reads @plugin lines from a running server, so use a throwaway one on its own
  # socket (leaves your real tmux sessions alone).
  tmux -L tpm-install -f "$HOME/.config/tmux/tmux.conf" new-session -d -s tpm
  tmux -L tpm-install run-shell "$TPM/bin/install_plugins" || echo "tpm install_plugins failed; run prefix+I inside tmux"
  tmux -L tpm-install kill-server 2>/dev/null || true
fi
