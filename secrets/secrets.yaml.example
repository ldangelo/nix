# Example secrets file structure
# Copy this to secrets.yaml and edit with: nix-shell -p sops --run "sops secrets/secrets.yaml"
#
# After editing, the file will be encrypted and safe to commit to git
# The actual secrets.yaml file should NOT be committed in plaintext

github:
  token: your-github-token-here

ssh:
  id_ed25519: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    your-private-key-here
    -----END OPENSSH PRIVATE KEY-----

  id_ed25519_pub: ssh-ed25519 your-public-key-here

# WakaTime API key (https://wakatime.com/api-key)
# Set with: sops secrets/secrets.yaml
#   - Then add wakatime_api_key: ENC[...encrypted...]
# Wire: modules/home-manager/sops.nix renders ~/.wakatime.cfg from this key
wakatime_api_key: waka_REPLACE_WITH_YOUR_KEY
